# Linux Systemd 后台常驻守护进程服务配置模板
# 适用场景: 在 Linux VPS / Ubuntu / Debian 服务器上 7x24 小时后台运行 Hermes Agent 或 OpenClaw
#
# 安装步骤:
# 1. sudo cp examples/linux_agent.service.example /etc/systemd/system/hermes-agent.service
# 2. 根据实际情况修改下方的 User、WorkingDirectory 与 ExecStart
# 3. sudo systemctl daemon-reload
# 4. sudo systemctl enable --now hermes-agent
# 5. 查看运行状态: sudo systemctl status hermes-agent
# 6. 查看实时日志: sudo journalctl -u hermes-agent -f

[Unit]
Description=Hermes Autonomous AI Agent Service (NuoAPI Backend)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/.hermes/.env
Environment=NODE_ENV=production
Environment=OPENAI_BASE_URL=https://nuoapi.net/v1
ExecStart=/usr/local/bin/hermes daemon
Restart=always
RestartSec=5s
LimitNOFILE=65535

# 安全加固策略
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.hermes /home/ubuntu/workspace

[Install]
WantedBy=multi-user.target
