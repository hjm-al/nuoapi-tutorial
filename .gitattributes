# 统一换行符：仓库内文本一律规范化，检出时按文件类型控制行尾
# 兜底 FAQ「Linux/WSL 运行」一节承诺的开箱即用，避免 Windows 检出把 .sh 变成 CRLF
* text=auto

# POSIX 脚本与 Python 在任何平台检出都必须是 LF
*.sh   text eol=lf
*.py   text eol=lf
*.service text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
